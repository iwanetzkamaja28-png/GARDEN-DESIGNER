    Stwórz swój wymarzony ogród.
  &lt;/p&gt;

  &lt;div class=&quot;workspace&quot;&gt;

    &lt;aside class=&quot;panel&quot;&gt;
      &lt;h3&gt;Biblioteka roślin&lt;/h3&gt;

      &lt;button class=&quot;plant active&quot; data-plant=&quot;🌳&quot;&gt;
        &lt;span&gt;🌳&lt;/span&gt; Drzewo
      &lt;/button&gt;

      &lt;button class=&quot;plant&quot; data-plant=&quot;🌷&quot;&gt;
        &lt;span&gt;🌷&lt;/span&gt; Tulipan
      &lt;/button&gt;

      &lt;button class=&quot;plant&quot; data-plant=&quot;🌿&quot;&gt;
        &lt;span&gt;🌿&lt;/span&gt; Krzew
      &lt;/button&gt;

      &lt;button class=&quot;plant&quot; data-plant=&quot;🌾&quot;&gt;
        &lt;span&gt;🌾&lt;/span&gt; Trawa ozdobna
      &lt;/button&gt;

      &lt;button class=&quot;plant&quot; data-plant=&quot;🌹&quot;&gt;
        &lt;span&gt;🌹&lt;/span&gt; Róża
      &lt;/button&gt;

      &lt;button class=&quot;plant&quot; data-plant=&quot;🪨&quot;&gt;
        &lt;span&gt;🪨&lt;/span&gt; Kamień
      &lt;/button&gt;

      &lt;p class=&quot;hint&quot;&gt;
        Wybierz element, a następnie kliknij pole
        na planszy ogrodu.
      &lt;/p&gt;
    &lt;/aside&gt;

    &lt;section class=&quot;editor&quot;&gt;

      &lt;div class=&quot;toolbar&quot;&gt;
        &lt;strong&gt;Twój projekt&lt;/strong&gt;

        &lt;div&gt;
          &lt;button class=&quot;secondary&quot; id=&quot;remove&quot;&gt;
            Usuń element
          &lt;/button&gt;

          &lt;button class=&quot;action&quot; id=&quot;save&quot;&gt;
            Zapisz
          &lt;/button&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      &lt;div class=&quot;garden&quot; id=&quot;garden&quot;&gt;&lt;/div&gt;

      &lt;p class=&quot;status&quot; id=&quot;status&quot;&gt;
        Wybierz roślinę i kliknij na planszę.
      &lt;/p&gt;

      &lt;button class=&quot;secondary&quot; id=&quot;clear&quot;&gt;
        Wyczyść ogród
      &lt;/button&gt;

    &lt;/section&gt;
  &lt;/div&gt;
&lt;/main&gt;

&lt;footer&gt;
  GARDEN DESIGNER © 2026
&lt;/footer&gt;

&lt;script&gt;
const garden = document.getElementById(&quot;garden&quot;);
const statusText = document.getElementById(&quot;status&quot;);

let selectedPlant = &quot;🌳&quot;;
let removeMode = false;

let cells = Array(64).fill(&quot;&quot;);

const saved = localStorage.getItem(&quot;gardenProject&quot;);

if (saved) {
  try {
    const parsed = JSON.parse(saved);
    if (Array.isArray(parsed) &amp;&amp; parsed.length === 64 &amp;&amp;
        parsed.every(x =&gt; typeof x === &quot;string&quot;)) {
      cells = parsed;
    }
  } catch (error) {
    console.log(&quot;Nie udało się wczytać projektu.&quot;);
  }
}

function render() {
  garden.innerHTML = &quot;&quot;;

  cells.forEach((plant, index) =&gt; {
    const cell = document.createElement(&quot;div&quot;);

    cell.className = &quot;cell&quot; + (plant ? &quot; occupied&quot; : &quot;&quot;);
    cell.textContent = plant;

    cell.addEventListener(&quot;click&quot;, () =&gt; {
      if (removeMode) {
        cells[index] = &quot;&quot;;
      } else {
        cells[index] = selectedPlant;
      }

      render();
      statusText.textContent = &quot;Zmieniono projekt ogrodu.&quot;;
    });

    garden.appendChild(cell);
  });
}

document.querySelectorAll(&quot;.plant&quot;).forEach(button =&gt; {
  button.addEventListener(&quot;click&quot;, () =&gt; {
    selectedPlant = button.dataset.plant;
    removeMode = false;

    document.querySelectorAll(&quot;.plant&quot;).forEach(b =&gt; {
      b.classList.remove(&quot;active&quot;);
    });

    button.classList.add(&quot;active&quot;);
    statusText.textContent = &quot;Wybrano roślinę: &quot; + selectedPlant;
  });
});

document.getElementById(&quot;remove&quot;).addEventListener(&quot;click&quot;, () =&gt; {
  removeMode = true;

  document.querySelectorAll(&quot;.plant&quot;).forEach(b =&gt; {
    b.classList.remove(&quot;active&quot;);
  });

  statusText.textContent = &quot;Kliknij element, który chcesz usunąć.&quot;;
});

document.getElementById(&quot;save&quot;).addEventListener(&quot;click&quot;, () =&gt; {
  localStorage.setItem(&quot;gardenProject&quot;, JSON.stringify(cells));
  statusText.textContent = &quot;Projekt zapisany! ✓&quot;;
});

document.getElementById(&quot;clear&quot;).addEventListener(&quot;click&quot;, () =&gt; {
  if (confirm(&quot;Czy na pewno wyczyścić cały ogród?&quot;)) {
    cells = Array(64).fill(&quot;&quot;);
    render();
    statusText.textContent = &quot;Plansza została wyczyszczona.&quot;;
  }
});

render();
&lt;/script&gt;

